{
  "name": "motion-pointer",
  "version": "2.0.1",
  "description": "Small custom mouse cursor CSS & JS library for fancy UX.",
  "keywords": [
    "custom cursor",
    "custom pointer",
    "cursor js",
    "cursor css",
    "fancy cursor",
    "motion cursor",
    "cursor"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev:scss": "minify ./src/css/params.css ./src/css/reset.css ./src/css/cursor.css > ./dist/index.css ",
    "dev:js": "minify ./src/js/cursor.js > ./dist/index.js",
    "dev": "npm-run-all -p dev:*"
  },
  "repository": "https://github.com/SG-WebDev/motion-pointer",
  "author": "SG-WebDev",
  "license": "MIT",
  "devDependencies": {
    "minify": "^8.0.4",
    "npm-run-all": "^4.1.5"
  }
}
